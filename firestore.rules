rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    // User Profile Validation
    function isValidUserProfile(data) {
      return data.id is string && data.id == request.auth.uid &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 64)) &&
             (!('email' in data) || (data.email is string && data.email.size() <= 128)) &&
             (!('faction' in data) || (data.faction is string && data.faction.size() <= 64)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
             data.highestFloor is number && data.highestFloor >= 1 && data.highestFloor <= 1000 &&
             data.totalRads is number && data.totalRads >= 0 &&
             data.runsPlayed is number && data.runsPlayed >= 0 &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    // Leaderboard Entry Validation
    function isValidLeaderboardEntry(data) {
      return data.id is string && isValidId(data.id) &&
             data.userId is string && data.userId == request.auth.uid &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 64)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
             data.floorLevel is number && data.floorLevel >= 1 &&
             data.radsCollected is number && data.radsCollected >= 0 &&
             data.outcome in ['victory', 'defeated'] &&
             data.createdAt is timestamp;
    }

    // Saved Game Validation
    function isValidSavedGame(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.floorLevel is number && data.floorLevel >= 1 &&
             data.seed is number &&
             data.playerX is number &&
             data.playerY is number &&
             data.currentRoomId is string && data.currentRoomId.size() >= 1 && data.currentRoomId.size() <= 64 &&
             data.health is number && data.health >= 0 &&
             data.maxHealth is number && data.maxHealth >= 1 &&
             data.ammo is number && data.ammo >= 0 &&
             (!('explosivesAmmo' in data) || (data.explosivesAmmo is number && data.explosivesAmmo >= 0)) &&
             (!('intelCollected' in data) || (data.intelCollected is number && data.intelCollected >= 0)) &&
             (!('clearedRoomIds' in data) || (data.clearedRoomIds is list && data.clearedRoomIds.size() <= 50)) &&
             (!('visitedRoomIds' in data) || (data.visitedRoomIds is list && data.visitedRoomIds.size() <= 50)) &&
             data.updatedAt is timestamp;
    }

    // Collection: /users/{userId}
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn();

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       userId == request.auth.uid &&
                       isValidUserProfile(incoming()) &&
                       incoming().createdAt == request.time &&
                       incoming().updatedAt == request.time &&
                       incoming().keys().hasAll(['id', 'highestFloor', 'totalRads', 'runsPlayed', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['id', 'displayName', 'email', 'faction', 'photoURL', 'highestFloor', 'totalRads', 'runsPlayed', 'createdAt', 'updatedAt']);

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       userId == request.auth.uid &&
                       isValidUserProfile(incoming()) &&
                       incoming().id == existing().id &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt == request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'faction', 'photoURL', 'highestFloor', 'totalRads', 'runsPlayed', 'updatedAt']);

      allow delete: if false;
    }

    // Collection: /leaderboard/{runId}
    match /leaderboard/{runId} {
      allow get: if isValidId(runId);
      allow list: if request.query.limit <= 50;

      allow create: if isSignedIn() &&
                       isValidId(runId) &&
                       incoming().id == runId &&
                       isValidLeaderboardEntry(incoming()) &&
                       incoming().createdAt == request.time &&
                       incoming().keys().hasAll(['id', 'userId', 'floorLevel', 'radsCollected', 'outcome', 'createdAt']) &&
                       incoming().keys().hasOnly(['id', 'userId', 'displayName', 'photoURL', 'floorLevel', 'radsCollected', 'outcome', 'createdAt']);

      allow update, delete: if false;
    }

    // Collection: /saves/{userId}
    match /saves/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && userId == request.auth.uid;
      allow list: if false;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       userId == request.auth.uid &&
                       isValidSavedGame(incoming()) &&
                       incoming().updatedAt == request.time;

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       userId == request.auth.uid &&
                       isValidSavedGame(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().updatedAt == request.time;

      allow delete: if isSignedIn() &&
                       isValidId(userId) &&
                       userId == request.auth.uid;
    }
  }
}
